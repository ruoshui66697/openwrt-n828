/dts-v1/;

#include "rt3050.dtsi"
#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/input/input.h>

/ {
	compatible = "n828", "ralink,rt3052-soc";
	model = "N828 CPE";

	aliases {
		led-boot = &led_system;
		led-failsafe = &led_system;
		led-running = &led_system;
		led-upgrade = &led_system;
	};

	gpio-keys {
		compatible = "gpio-keys-polled";
		poll-interval = <20>;

		reset {
			label = "reset";
			/* 修正：实测 Reset 按键连接的是 GPIO 0 (Pin 17) */
			gpios = <&gpio0 0 GPIO_ACTIVE_LOW>;
			linux,code = <KEY_RESTART>;
		};
	};

	gpio-leds {
		compatible = "gpio-leds";

		/* 警告：原 DTS 中 System LED 使用的 GPIO 13 属于 uartf 组 (UART RX)。
		   为避免与串口控制台冲突，此处暂时注释掉。
		   待确认硬件上 System LED 的实际 GPIO 后再启用。 */
		/*
		led_system: system {
			label = "n828:green:system";
			gpios = <&gpio0 13 GPIO_ACTIVE_LOW>;
		};
		*/

		/* 为了满足 aliases 的引用，这里提供一个 dummy (虚拟) 节点，
		   或者你可以把 aliases 里的 led-system 指向一个确定的 LED (如 signal_1) */
		led_system: signal_1 {
			label = "n828:green:signal1";
			/* 信号1使用 GPIO 17，属于 jtag 组，Pinmux 已正确配置 */
			gpios = <&gpio0 17 GPIO_ACTIVE_LOW>;
		};

		signal_2 {
			label = "n828:green:signal2";
			gpios = <&gpio0 18 GPIO_ACTIVE_LOW>;
		};

		/* 信号灯3 (GPIO 21) 待 sysfs 实测后补充 */
	};
};

&spi0 {
	status = "okay";

	flash@0 {
		compatible = "jedec,spi-nor";
		reg = <0>;
		spi-max-frequency = <10000000>;

		partitions {
			compatible = "fixed-partitions";
			#address-cells = <1>;
			#size-cells = <1>;

			partition@0 {
				label = "u-boot";
				reg = <0x0 0x30000>;
				read-only;
			};

			partition@30000 {
				label = "u-boot-env";
				reg = <0x30000 0x10000>;
				read-only;
			};

			factory: partition@40000 {
				label = "factory";
				reg = <0x40000 0x10000>;
				read-only;
			};

			partition@50000 {
				compatible = "denx,uimage";
				label = "firmware";
				reg = <0x50000 0x3b0000>;
			};
		};
	};
};

&state_default {
	gpio {
		/* 修正：移除了 "uartf"。
		   uartf 组包含 GPIO 7~14，强制复用为 gpio 会与 UART 驱动冲突，
		   导致 Pinmux 报错 -22 甚至串口控制台失效。
		   保留 i2c (GPIO 1,2) 和 jtag (GPIO 17~21) 复用为 gpio。 */
		groups = "i2c", "jtag";
		function = "gpio";
	};
};

&ethernet {
	status = "okay";
	mtd-mac-address = <&factory 0x28>;
};

&esw {
	status = "okay";
	mediatek,portmap = <0x2f>;
};

&wmac {
	status = "okay";
	ralink,mtd-eeprom = <&factory 0x0>;
};
